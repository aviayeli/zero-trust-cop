# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Build artifacts
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Environment / secrets
.env

# Google OAuth artifacts — bearer credentials, never committed
token.json
token.json.*
credentials.json
config/*/token.json
config/*/credentials.json
credentials.json
client_secret_*.json
*:Zone.Identifier

# Ed25519 private key material
*.pem
config/*/signing_key*
!config/*/signing_key.pem.example

# Claude Code local config and throwaway Builder worktrees
.claude/

# ngrok league exposure. The two agent configs hold LIVE bearer authtokens —
# one per account, since the free tier allows a single agent session each —
# so they are kept on disk and out of the history. The pidfiles and logs are
# one run's runtime state.
scripts/ngrok_cop.yml
scripts/ngrok_thief.yml
scripts/ngrok_unified.yml
.ngrok-*.pid
.ngrok-*.log
